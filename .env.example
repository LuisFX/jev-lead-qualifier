# Copy to .env (gitignored) and fill in. run.sh reads it; variables already set in your shell win.
# Without TYPESAFE_API_KEY the app still starts and every page renders; scoring asks for the key.

# Required for live scoring (Jev, TypeSafe System One). JEV_API_KEY is accepted as an alias.
TYPESAFE_API_KEY=your-typesafe-api-key

# Optional: "Enrich via Apollo" button on the Connect page (read-only, cached). Off unless both are set.
APOLLO_API_KEY=your-apollo-api-key
APOLLO_ENRICH=0

# Optional HubSpot write (HandOff of Hot). Off unless both are set. Use a test contact.
# HUBSPOT_ACCESS_TOKEN=your-hubspot-token
# HUBSPOT_WRITE=0
# HUBSPOT_TEST_CONTACT_ID=

# Optional Email plugin credentials. Occupancy is a Connect mount, not INSTANTLY_SEND.
# Ready is key + campaign id. After adding a key, restart. Use a test campaign.
# INSTANTLY_API_KEY=your-instantly-api-key
# INSTANTLY_CAMPAIGN_ID=
# INSTANTLY_TEST_EMAIL=

# Optional SMS / Voice plugin credentials. Occupancy is a Connect mount.
# Ready is SID + token + from-number. After adding a key, restart. No live POST until you say so.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Server
PORT=8780
# Small thread pool: the public endpoint rate-limits shared keys.
FIRSTREAD_WORKERS=4
